{
  "name": "hivelink",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test lib/*.test.ts",
    "test:norwegian": "tsx --test lib/norwegian-dictionary.test.ts",
    "test:tree": "tsx --test lib/occurrence-tree.test.ts",
    "data:puzzles": "tsx scripts/regenerate-daily.ts",
    "data:words": "tsx scripts/import-compound-words.ts",
    "data:norwegian": "tsx scripts/build-norwegian-compounds.ts && tsx scripts/derive-compound-runtime.ts",
    "data:norwegian:nowac": "tsx scripts/build-norwegian-compounds.ts --with-nowac && tsx scripts/derive-compound-runtime.ts",
    "data:derive": "tsx scripts/derive-compound-runtime.ts",
    "data:verify": "tsx scripts/verify-norwegian-data.ts",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.7.1",
    "@vercel/og": "^0.8.5",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.11.17",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },

  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
