// Prisma schema for HiveLink
// Using Neon Serverless Postgres

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model DailyPuzzle {
  id           Int      @id @default(autoincrement())
  date         DateTime @unique @db.Date
  startWord    String   @map("start_word")
  goalWord     String   @map("goal_word")
  optimalSteps Int?     @map("optimal_steps")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("daily_puzzles")
}

model Score {
  id          Int      @id @default(autoincrement())
  puzzleDate  DateTime @map("puzzle_date") @db.Date
  playerId    String   @map("player_id")
  playerName  String?  @map("player_name")
  wordsUsed   Int      @map("words_used")
  layers      Int
  pathsFound  Int      @default(1) @map("paths_found")
  finishedAt  DateTime @default(now()) @map("finished_at")
  isDaily     Boolean  @default(true) @map("is_daily")

  @@unique([puzzleDate, playerId])
  @@index([puzzleDate])
  @@index([playerId])
  @@map("scores")
}

model CompoundWord {
  word      String   @id
  parts     String[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("compound_words")
}

model AdReward {
  id          Int      @id @default(autoincrement())
  playerId    String   @map("player_id")
  rewardType  String   @map("reward_type") // 'hint', 'practice_unlimited', 'streak_protection', 'ad_free'
  unlockedAt  DateTime @default(now()) @map("unlocked_at")
  expiresAt   DateTime? @map("expires_at")
  usedAt      DateTime? @map("used_at")
  metadata    String?  // JSON string for additional data (e.g., hint count, practice puzzle count)

  @@index([playerId])
  @@index([rewardType])
  @@index([expiresAt])
  @@map("ad_rewards")
}

